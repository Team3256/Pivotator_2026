            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/stowPressed"
          },
          {
            "key": "intakePressed",
            "name": "RB pressed (coral intake)",
            "type": "boolean",
            "initial": false,
            "category": "operator",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/intakePressed"
          },
          {
            "key": "l1Pressed",
            "name": "LB pressed (L1)",
            "type": "boolean",
            "initial": false,
            "category": "operator",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/l1Pressed"
          },
          {
            "key": "l2Pressed",
            "name": "B pressed (L2)",
            "type": "boolean",
            "initial": false,
            "category": "operator",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/l2Pressed"
          },
          {
            "key": "l3Pressed",
            "name": "X pressed (L3)",
            "type": "boolean",
            "initial": false,
            "category": "operator",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/l3Pressed"
          },
          {
            "key": "l4Pressed",
            "name": "Y pressed (L4)",
            "type": "boolean",
            "initial": false,
            "category": "operator",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/l4Pressed"
          },
          {
            "key": "enabled",
            "name": "Robot enabled",
            "type": "boolean",
            "initial": false,
            "category": "internal",
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/enabled"
          },
          {
            "key": "scored",
            "name": "Coral just scored",
            "type": "boolean",
            "initial": false,
            "category": "internal",
            "event": true,
            "channel": "/RealOutputs/Mayhem/States/Superstructure/inputs/scored",
            "derivedFrom": [
              {
                "machine": "EndEffector",
                "key": "hasCoral"
              }
            ]
          }
        ],
        "transitions": [
          {
