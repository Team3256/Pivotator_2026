{
  "format": "mayhem-suite",
  "version": 1,
  "revision": 4,
  "id": "pivotator-2026",
  "name": "Pivotator 2026",
  "field": {
    "name": "2025 REEFSCAPE",
    "width": 17.548,
    "height": 8.052
  },
  "robot": {
    "name": "Pivotvator (no drivetrain yet)",
    "length": 0.85,
    "width": 0.85,
    "start": {
      "x": 2,
      "y": 4,
      "heading": 0
    },
    "constraints": {
      "maxVelocity": 4.5,
      "maxAcceleration": 12,
      "maxAngularVelocity": 12.566370614359172,
      "maxAngularAcceleration": 26.17993877991494,
      "translationKp": 5,
      "rotationKp": 3
    }
  },
  "signals": [],
  "routines": [
    {
      "id": "score-l4-in-place",
      "name": "Score L4 in place",
      "initial": "raise",
      "description": "No drivetrain yet: raise to L4 where the robot stands, score the preloaded coral, stow.",
      "nodes": [
        {
          "id": "raise",
          "name": "Raise to L4",
          "kind": "action",
          "action": "superstructure.scoreL4",
          "timeout": 5,
          "description": "Superstructure goal L4; done when Motion reaches AT_GOAL."
        },
        {
          "id": "score",
          "name": "Score coral",
          "kind": "action",
          "action": "superstructure.score",
          "timeout": 3,
          "description": "Rollers push the preloaded coral onto the reef; done when the sensor clears."
        },
        {
          "id": "stow",
          "name": "Stow",
          "kind": "action",
          "action": "superstructure.stow",
          "timeout": 5,
          "description": "Superstructure goal STOW; done when Motion reaches AT_GOAL."
        },
        {
          "id": "done",
          "name": "Auto complete",
          "kind": "finish",
          "timeout": 1
        }
      ],
      "transitions": [
        {
          "id": "at-l4",
          "from": "raise",
          "to": "score",
          "condition": {
            "kind": "always"
          }
        },
        {
          "id": "scored",
          "from": "score",
          "to": "stow",
          "condition": {
            "kind": "always"
          }
        },
        {
          "id": "stowed",
          "from": "stow",
          "to": "done",
          "condition": {
            "kind": "always"
          }
        }
      ]
    }
  ],
  "extensions": {
    "machines": [
      {
        "format": "mayhem-machine",
        "version": 1,
        "id": "Superstructure",
        "name": "Superstructure goal",
        "description": "Where the driver wants the end effector: stowed, at the coral intake, or at a reef level. Each button picks a goal; Motion gets the pivot, elevator and wrist there safely.",
        "initial": "STOW",
        "states": [
          {
            "id": "STOW",
            "name": "Stow",
            "description": "Elevator down, pivot upright, wrist in line.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "CORAL_INTAKE",
            "name": "Coral intake",
            "description": "Pivot tipped forward, wrist down to take coral.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "L1",
            "name": "L1",
            "description": "Trough.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "L2",
            "name": "L2",
            "description": "Reef level 2.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "L3",
            "name": "L3",
            "description": "Reef level 3.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "L4",
            "name": "L4",
            "description": "Reef level 4: elevator near full extension.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          }
        ],
        "inputs": [
