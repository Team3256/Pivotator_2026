            "name": "RB"
          },
          {
            "id": "any-to-L1",
            "from": "*",
            "to": "L1",
            "condition": {
              "kind": "signal",
              "key": "l1Pressed",
              "op": "eq",
              "value": true
            },
            "name": "LB"
          },
          {
            "id": "any-to-L2",
            "from": "*",
            "to": "L2",
            "condition": {
              "kind": "signal",
              "key": "l2Pressed",
              "op": "eq",
              "value": true
            },
            "name": "B"
          },
          {
            "id": "any-to-L3",
            "from": "*",
            "to": "L3",
            "condition": {
              "kind": "signal",
              "key": "l3Pressed",
              "op": "eq",
              "value": true
            },
            "name": "X"
          },
          {
            "id": "any-to-L4",
            "from": "*",
            "to": "L4",
            "condition": {
              "kind": "signal",
              "key": "l4Pressed",
              "op": "eq",
              "value": true
            },
            "name": "Y"
          }
        ]
      },
      {
        "format": "mayhem-machine",
        "version": 1,
        "id": "Motion",
        "name": "Motion",
        "description": "Moves the pivot, elevator and wrist to the goal in a safe order. The pivot swings the whole elevator, so before a big pivot move the elevator is pulled in below the safe height; it extends only once the pivot is there.",
        "initial": "IDLE",
        "selection": "priority",
        "states": [
          {
            "id": "IDLE",
            "name": "Idle",
            "description": "Robot disabled: motors off.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "RETRACTING",
            "name": "Retracting",
            "description": "Elevator pulls in below the safe height; the pivot holds where it is.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "PIVOTING",
            "name": "Pivoting",
            "description": "Elevator held in; pivot and wrist move to the goal.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "EXTENDING",
            "name": "Extending",
            "description": "Pivot there; elevator and wrist finish moving to the goal.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "AT_GOAL",
            "name": "At goal",
            "description": "Everything within tolerance of the goal.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          }
        ],
        "inputs": [
          {
            "key": "enabled",
            "name": "Robot enabled",
            "type": "boolean",
            "initial": false,
            "category": "internal",
            "channel": "/RealOutputs/Mayhem/States/Motion/inputs/enabled"
          },
          {
            "key": "pivotFar",
            "name": "Pivot far from its goal (over 5°, until back within 2°)",
            "type": "boolean",
            "initial": false,
            "category": "sensor",
            "channel": "/RealOutputs/Mayhem/States/Motion/inputs/pivotFar"
          },
          {
            "key": "elevatorSafe",
            "name": "Elevator below the pivot-safe height",
            "type": "boolean",
            "initial": false,
            "category": "sensor",
            "channel": "/RealOutputs/Mayhem/States/Motion/inputs/elevatorSafe"
          },
          {
            "key": "atGoal",
            "name": "Pivot, elevator and wrist at the goal",
            "type": "boolean",
            "initial": false,
            "category": "sensor",
            "channel": "/RealOutputs/Mayhem/States/Motion/inputs/atGoal"
          }
        ],
