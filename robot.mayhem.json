            "to": "STOW",
            "condition": {
              "kind": "signal",
              "key": "enabled",
              "op": "eq",
              "value": false
            },
            "name": "Disabled"
          },
          {
            "id": "any-to-STOW-2",
            "from": "*",
            "to": "STOW",
            "condition": {
              "kind": "any",
              "conditions": [
                {
                  "kind": "signal",
                  "key": "stowPressed",
                  "op": "eq",
                  "value": true
                },
                {
                  "kind": "signal",
                  "key": "scored",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "name": "A, or coral scored"
          },
          {
            "id": "any-to-CORAL_INTAKE",
            "from": "*",
            "to": "CORAL_INTAKE",
