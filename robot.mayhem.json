            "from": "*",
            "to": "IDLE",
            "condition": {
              "kind": "signal",
              "key": "enabled",
              "op": "eq",
              "value": false
            },
            "name": "Disabled"
          },
          {
            "id": "any-to-RETRACTING",
            "from": "*",
            "to": "RETRACTING",
            "condition": {
              "kind": "all",
              "conditions": [
                {
                  "kind": "signal",
                  "key": "pivotFar",
                  "op": "eq",
                  "value": true
                },
                {
                  "kind": "signal",
                  "key": "elevatorSafe",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            "name": "Pull the elevator in first"
          },
          {
            "id": "any-to-PIVOTING",
            "from": "*",
            "to": "PIVOTING",
            "condition": {
              "kind": "signal",
              "key": "pivotFar",
              "op": "eq",
              "value": true
            },
            "name": "Swing the pivot"
          },
          {
            "id": "any-to-EXTENDING",
            "from": "*",
            "to": "EXTENDING",
            "condition": {
              "kind": "signal",
              "key": "atGoal",
              "op": "eq",
              "value": false
            },
            "name": "Extend to the goal"
          },
          {
            "id": "any-to-AT_GOAL",
            "from": "*",
            "to": "AT_GOAL",
            "condition": {
              "kind": "always"
            },
            "name": "At goal"
          }
        ]
      },
      {
