            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "HOLDING",
            "name": "Holding",
            "description": "Coral in; a small inward push keeps it there.",
            "source": "src/main/cpp/subsystems/Superstructure.cpp"
          },
          {
            "id": "SCORING",
            "name": "Scoring",
            "description": "Rollers push the coral out onto the reef.",
